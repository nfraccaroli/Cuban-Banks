  </div>`).join('');
  renderScatter();
}

function renderScatter(){
  const svg = document.getElementById('scatter-svg');
  const W=600, H=280, pad={l:60,r:20,t:20,b:40};
  const bks = filteredBanks().filter(b=>b.assetIdx>0);
  if(!bks.length){svg.innerHTML='<text x="300" y="140" text-anchor="middle" fill="#aaa" font-size="12">Sin datos</text>';return;}
  let maxX=Math.max(...bks.map(b=>b.assetIdx));
  let maxY=Math.max(...bks.map(b=>b.provinces));
  let maxD=Math.max(...bks.map(b=>b.depositIdx||1));
  const colors=['#1a3a8f','#c0392b','#27ae60','#9a6e0a','#8e44ad','#16a085','#d35400','#2980b9'];
  let dots = bks.map((b,i)=>{
    let x=pad.l+(b.assetIdx/maxX)*(W-pad.l-pad.r);
    let y=pad.t+(1-b.provinces/maxY)*(H-pad.t-pad.b);
    let r=6+((b.depositIdx||1)/maxD)*14;
    return `<circle cx="${x}" cy="${y}" r="${r}" fill="${colors[i%colors.length]}" opacity="0.75" stroke="#fff" stroke-width="1.5"/>
      <text x="${x}" y="${y-r-4}" text-anchor="middle" font-size="9" fill="#444" font-family="JetBrains Mono,monospace">${b.short}</text>`;
  }).join('');
  svg.innerHTML=`
    <line x1="${pad.l}" y1="${H-pad.b}" x2="${W-pad.r}" y2="${H-pad.b}" stroke="#e2e6ea" stroke-width="1"/>
    <line x1="${pad.l}" y1="${pad.t}" x2="${pad.l}" y2="${H-pad.b}" stroke="#e2e6ea" stroke-width="1"/>
    <text x="${W/2}" y="${H-5}" text-anchor="middle" font-size="9" fill="#9aa5b1" font-family="JetBrains Mono,monospace">Importancia Sistémica (índice activos)</text>
    <text x="14" y="${H/2}" text-anchor="middle" font-size="9" fill="#9aa5b1" font-family="JetBrains Mono,monospace" transform="rotate(-90,14,${H/2})">Cobertura Geográfica (provincias)</text>
    ${dots}`;
}

