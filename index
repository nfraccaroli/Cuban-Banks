// ─── UTILITY ────────────────────────────────────────────────────────────────
function fmt(val_cup, decimals=0){
  if(val_cup===null) return '<span class="null-v">N/D</span>';
  let v = currency==='USD' ? val_cup/RATE : val_cup;
  let sym = currency==='CUP' ? 'MM CUP' : 'MM USD';
  if(v>=1000000) return (v/1000000).toFixed(1)+'B '+sym;
  if(v>=1000) return (v/1000).toFixed(1)+'MM '+sym;
  return v.toFixed(decimals)+' '+sym;
}
function fmtPct(v){ return v===null ? '<span class="null-v">N/D</span>' : v.toFixed(1)+'%'; }
function fmtNum(v){ return v===null ? '<span class="null-v">N/D</span>' : v.toLocaleString(); }

function filteredBanks(){
  if(activeType==='all') return banks;
  return banks.filter(b=>b.tipo===activeType);
}

// ─── TAB SWITCHING ──────────────────────────────────────────────────────────
function switchTab(name, el){
  document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));
  document.querySelectorAll('.nav-tab').forEach(t=>t.classList.remove('active'));
  document.getElementById('view-'+name).classList.add('active');
  el.classList.add('active');
  if(name==='overview') renderOverview();
  if(name==='compare') renderCompare();
  if(name==='profile') renderProfileInit();
}

// ─── FILTER & CURRENCY ──────────────────────────────────────────────────────
function filterType(type, el){
  activeType = type;
  document.querySelectorAll('.pill').forEach(p=>p.classList.remove('ap','apb'));
  el.classList.add(type==='all'?'ap':'apb');
  renderOverview();
  renderCompare();
}
function setCurr(c){
  currency = c;
  document.getElementById('btn-cup').classList.toggle('active',c==='CUP');
  document.getElementById('btn-usd').classList.toggle('active',c==='USD');
  document.getElementById('h-assets-sub').textContent = c==='CUP'?'CUP estimado 2023':'USD estimado 2023';
  document.getElementById('bar-curr-label').textContent = c;
  let totalCup = banks.filter(b=>b.assets_cup).reduce((s,b)=>s+b.assets_cup,0);
  let total = c==='CUP' ? totalCup : totalCup/RATE;
  document.getElementById('h-assets').textContent = total>=1000000?(total/1000000).toFixed(1)+'B':'~'+(total/1000).toFixed(0)+'MM';
  renderTable();
  renderBarsAssets();
}

// ─── BARS ───────────────────────────────────────────────────────────────────
function barHTML(name, val_cup, max_cup, color){
  let pct = max_cup>0 ? Math.round((val_cup||0)/max_cup*100) : 0;
  let label = val_cup===null ? '<span class="null-v">N/D</span>' : fmt(val_cup);
  return `<div class="br">
    <div class="brn" title="${name}">${name}</div>
    <div class="brt"><div class="brf" style="width:${pct}%;background:${color}"></div></div>
    <div class="brv">${label}</div>
  </div>`;
}

function renderBarsAssets(){
  let fb = filteredBanks().filter(b=>b.assets_cup).sort((a,b)=>b.assets_cup-a.assets_cup);
  let max = fb.length>0 ? fb[0].assets_cup : 1;
  document.getElementById('bar-assets-chart').innerHTML = fb.map(b=>barHTML(b.short, b.assets_cup, max, 'var(--accent)')).join('');
  if(fb.length===0) document.getElementById('bar-assets-chart').innerHTML='<div style="color:var(--dim);font-size:12px;padding:20px 0">Sin datos para el filtro seleccionado</div>';
}

// ─── TABLE ──────────────────────────────────────────────────────────────────
function sortTable(key){
  if(sortKey===key) sortAsc=!sortAsc; else {sortKey=key;sortAsc=false;}
  renderTable();
}
function renderTable(){
  let fb = [...filteredBanks()].sort((a,b)=>{
    let va=a[sortKey+'_cup']??a[sortKey]??'';
    let vb=b[sortKey+'_cup']??b[sortKey]??'';
    if(va===null)va=''; if(vb===null)vb='';
    if(typeof va==='number'&&typeof vb==='number') return sortAsc?va-vb:vb-va;
    return sortAsc?String(va).localeCompare(String(vb)):String(vb).localeCompare(String(va));
  });
  let badge = t => t==='Banco Central'?'<span class="tbadge" style="background:var(--red-l);color:var(--red);border:1px solid rgba(192,57,43,.2)">Central</span>':
                   t==='Estatal'?'<span class="tbadge tpub">Estatal</span>':
                   '<span class="tbadge tmix">S.A. Est.</span>';
  document.getElementById('table-body').innerHTML = fb.map(b=>`<tr>
    <td><strong>${b.name}</strong><br><span style="font-size:9px;color:var(--dim);font-family:var(--mono)">${b.short}</span></td>
    <td>${badge(b.tipo)}</td>
    <td class="mv">${b.founded}</td>
    <td class="mv">${fmt(b.assets_cup)}</td>
    <td class="mv">${fmt(b.deposits_cup)}</td>
    <td class="mv">${fmt(b.equity_cup)}</td>
    <td class="mv">${fmtPct(b.car)}</td>
    <td class="mv">${fmtPct(b.npl)}</td>
    <td style="font-size:10px;color:var(--dim)">${b.auditor}</td>
  </tr>`).join('');
}

